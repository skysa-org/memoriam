{
	"name": "memoriam",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "pnpm -r --parallel run dev",
		"build": "pnpm --filter @memoriam/core run build && pnpm --filter @memoriam/web run build && pnpm --filter @memoriam/api run build",
		"test": "pnpm -r run test",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "pnpm -r run typecheck",
		"db:generate": "pnpm --filter @memoriam/api run db:generate",
		"db:migrate": "pnpm --filter @memoriam/api run db:migrate",
		"db:migrate:remote": "pnpm --filter @memoriam/api run db:migrate:remote",
		"verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"deploy": "pnpm build && pnpm --filter @memoriam/api run deploy",
		"changeset": "changeset",
		"changeset:status": "changeset status",
		"changeset:version": "changeset version"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-functional": "^10.0.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prefer-arrow-functions": "^3.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0"
	}
}
